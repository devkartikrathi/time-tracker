// Chronos — data model
// Prisma 7: connection URL lives in prisma.config.ts; the client is instantiated
// with a driver adapter (see lib/prisma.ts).

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  REST
  WORK
  OTHER
}

enum Plan {
  FREE
  PRO
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id         String   @id @default(cuid())
  clerkId    String   @unique
  email      String   @unique
  firstName  String?
  lastName   String?
  occupation String?
  age        Int?
  focus      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Onboarding is an explicit fact, not inferred from whether optional
  // profile fields happen to be filled in.
  onboardingCompleted Boolean   @default(false)
  onboardedAt         DateTime?

  // Preferences
  plan         Plan   @default(FREE)
  timezone     String @default("UTC")
  weekStartsOn Int    @default(1) // 0 = Sunday, 1 = Monday

  // Denormalised streak state, recomputed on every day write so the
  // dashboard can read it without scanning the whole history.
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  lastLoggedDate String? // YYYY-MM-DD

  // Daily reminder, local to the user's timezone. Null = reminders off.
  reminderHour Int?

  subcategories     Subcategory[]
  dailyTasks        DailyTask[]
  goals             Goal[]
  achievements      Achievement[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Subcategory {
  id         String       @id @default(cuid())
  name       String
  color      String
  icon       String?
  category   CategoryType
  sortOrder  Int          @default(0)
  isArchived Boolean      @default(false)
  userId     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]

  @@index([userId, isArchived])
  @@map("subcategories")
}

model DailyTask {
  id     String @id @default(cuid())
  // YYYY-MM-DD. Unique *per user* — a global unique here would let one
  // user's entry block every other user from logging the same calendar day.
  date   String
  userId String

  wellBeingTags String[]
  // 24 slots, each null or an HourData object. One row per day keeps the
  // month view to a single indexed range scan.
  hours         Json
  mood          Int? // 1-5, optional daily check-in
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_tasks")
}

model Goal {
  id            String       @id @default(cuid())
  name          String
  targetHours   Float
  period        GoalPeriod   @default(DAILY)
  category      CategoryType
  subcategoryId String
  userId        String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("goals")
}

model Achievement {
  id         String   @id @default(cuid())
  key        String // e.g. "streak_7", "perfect_day", "first_week"
  userId     String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("achievements")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
